---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { render } from 'astro:content';
import { url, articles, categoryOf, clusterOf, coverCols, fmtDate, readMinutes, topicsOf, topicName, TIER_LABEL, type Article } from '../../data/util';
import { SOURCES } from '../../data/sources';
import { entity, entityPath } from '../../data/entities';
import { topicCategories } from '../../data/site';

export async function getStaticPaths() {
  const all = await articles();
  return all.map((a) => ({ params: { slug: a.id }, props: { a, all } }));
}
interface Props { a: Article; all: Article[] }
const { a, all } = Astro.props;
const { Content, headings } = await render(a);
const toc = headings.filter((h) => h.depth === 2);
const topics = topicsOf(a);
const tools = a.data.tools.map((t) => entity(t)!).filter(Boolean);
const concepts = a.data.concepts.map((t) => entity(t)!).filter(Boolean);
const refs = a.data.cites.map((id) => ({ id, s: SOURCES[id] }));
const cat = categoryOf(a.data.category);
const cl = clusterOf(a.data.cluster);
const node = topicCategories.includes(cat.slug) ? 'topics' : 'engineering';
const related = all.filter((x) => x.id !== a.id && x.data.cluster === a.data.cluster).concat(all.filter((x) => x.id !== a.id && x.data.cluster !== a.data.cluster && x.data.category === a.data.category)).slice(0, 3);
---
<Base title={a.data.title} description={a.data.description} node={node} field={false}>
  <article class="wrap" style="padding-top:40px">
    <header class="stack" style="gap:18px;max-width:860px" data-reveal>
      <div class="chips">
        <a class="chip" href={url(`categories/${cat.slug}/`)}>{cat.name}</a>
        <a class="chip purple" href={url(`clusters/${cl.slug}/`)}>{String(cl.n).padStart(2, '0')} · {cl.name}</a>
        {a.data.status === 'draft' && <span class="chip null">draft</span>}
      </div>
      <h1 style="font-size:clamp(32px,4.6vw,56px)">{a.data.title}</h1>
      <p class="lede">{a.data.description}</p>
      <span class="label ghost" style="letter-spacing:.1em">{fmtDate(a.data.date)} · {readMinutes(a.body)} min read</span>
    </header>
    <div class="card" style="aspect-ratio:21/8;margin:28px 0 36px;max-width:1100px">
      <canvas data-cover data-title={a.data.title} data-cols={coverCols(a)} style="position:absolute;inset:0;width:100%;height:100%" aria-hidden="true"></canvas>
    </div>
    <div class="article-grid">
      <div>
        <div class="prose">
          <Content />
        </div>

        {refs.length > 0 && (
          <section class="stack" style="gap:12px;margin-top:40px" id="references">
            <span class="label">References</span>
            <ol class="reflist">
              {refs.map(({ id, s }, i) => (
                <li id={`ref-${i + 1}`}>
                  {s.authors && <span>{s.authors}. </span>}
                  {s.url ? <a href={s.url}>{s.title}</a> : <span>{s.title}</span>}
                  {s.venue && <span class="dim">. {s.venue}</span>}{s.year && !(s.venue ?? "").includes(String(s.year)) && <span class="dim"> ({s.year})</span>}
                  <span class="tier">{TIER_LABEL[s.tier]}</span>
                  {s.topic !== 'external' && <a class="file" href={url(`topic/${s.topic}/`)}>corpus: ~/{s.topic}</a>}
                </li>
              ))}
            </ol>
          </section>
        )}

        {a.data.sources.length > 0 && (
          <section class="stack" style="gap:10px;margin-top:32px">
            <span class="label">Our records</span>
            <p class="ghost" style="margin:0;font-size:13px">The measurements in this article come from these records in the running system.</p>
            <ul style="margin:0;padding-left:1.1em;font-size:14px" class="dim">
              {a.data.sources.map((s) => <li><code style="font-family:var(--mono);color:var(--green);font-size:12px">{s.doc_key}</code> — {s.title}</li>)}
            </ul>
          </section>
        )}

        {(topics.length + tools.length + concepts.length) > 0 && (
          <aside class="card pad tagblock" style="margin-top:32px;border-color:rgba(158,119,255,.35)">
            {topics.length > 0 && <div class="row"><span class="k">Topics</span>{topics.map((t) => <a class="chip" href={url(`topic/${t}/`)}>{topicName(t)}</a>)}</div>}
            {tools.length > 0 && <div class="row"><span class="k">Tools</span>{tools.map((e) => <a class="chip purple" href={url(entityPath(e))}>{e.name}</a>)}</div>}
            {concepts.length > 0 && <div class="row"><span class="k">Concepts</span>{concepts.map((e) => <a class:list={['chip', { live: e.own }]} href={url(entityPath(e))}>{e.name}</a>)}</div>}
          </aside>
        )}
      </div>
      {toc.length > 2 && (
        <nav class="toc" aria-label="Contents">
          <span class="label">Contents</span>
          <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
          {refs.length > 0 && <a href="#references" style="display:block;margin-top:10px">References · {refs.length}</a>}
        </nav>
      )}
    </div>
    {related.length > 0 && (
      <section class="section">
        <span class="label">Read next</span>
        <div class="grid g3">{related.map((r) => <ArticleCard a={r} />)}</div>
      </section>
    )}
  </article>
</Base>
