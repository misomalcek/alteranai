---
import EntityPage from '../../components/EntityPage.astro';
import { CONCEPTS } from '../../data/entities';

export function getStaticPaths() {
  return CONCEPTS.map((e) => ({ params: { slug: e.slug }, props: { e: { ...e, kind: 'concept' as const } } }));
}
const { e } = Astro.props;
---
<EntityPage e={e} />
