---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { url, articles, type Article } from '../../data/util';

const base = import.meta.env.BASE_URL;
const all = await articles();

// Filter for media-related articles (category: engineering which is media)
const mediaArticles = all.filter((a) => a.data.category === 'engineering');
---

<Base title="Media Library - AlteranAI" description="Audio, infographics and slides from R2 bucket">
  <div class="wrap">
    <header class="stack" style="gap:14px;padding:56px 0 8px" data-reveal>
      <span class="label">Library · All Media</span>
      <h1>Media Library</h1>
      <p class="lede">{mediaArticles.length} media files available: audio, images, slides</p>
    </header>
    <section class="section">
      {mediaArticles.length > 0
        ? <div class="grid g3">{mediaArticles.map((a) => <ArticleCard a={a} />)}</div>
        : <div class="card pad"><p class="dim" style="margin:0">No media files uploaded yet. Coming soon...</p></div>}
    </section>
  </div>
</Base>

<style>
  .wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .stack {
    display: flex;
    flex-direction: column;
  }
  .lede {
    font-size: 20px;
    color: var(--ink-200);
    margin-top: 8px;
    line-height: 1.5;
  }
  .section {
    padding: 40px 0;
  }
</style>