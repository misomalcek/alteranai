---
import '../styles/global.css';
import { nodes, profiles } from '../data/site';
import { url } from '../data/util';

interface Props {
  title: string;
  description: string;
  /** which of the four nodes is active */
  node?: string;
  /** draw the ambient mycelial field behind the page */
  field?: boolean;
}
const { title, description, node, field = true } = Astro.props;
const full = title === 'AlteranAI' ? 'AlteranAI — intelligence that grows, not stacks' : `${title} — AlteranAI`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{full}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={full} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={new URL(url('media/logo.jpg'), Astro.site)} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#080C10" />
  <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
  <link rel="sitemap" href={url('sitemap-index.xml')} />
  <link rel="alternate" type="application/rss+xml" title="AlteranAI" href={url('rss.xml')} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>
  {field && <div class="ambient" aria-hidden="true"></div>}
  {field && <canvas class="field" data-myc="field" data-static="1" data-seed="7" aria-hidden="true"></canvas>}

  <nav class="nav" aria-label="Main">
    <a class="brand" href={url()}><img src={url('favicon.svg')} alt="" width="26" height="26" />ALTERANAI</a>
    <div class="tabs">
      {nodes.map((n) => <a class:list={['tab', { on: node === n.slug }]} href={url(`${n.slug}/`)}>{n.label}</a>)}
    </div>
  </nav>

  <main>
    <slot />
  </main>

  <footer class="foot">
    <div class="wrap stack" style="gap:22px">
      <nav class="foot-index" aria-label="Index">
        <a href={url('topics/')}>AI Topics</a><a href={url('engineering/')}>AI Engineering</a><a href={url('tags/')}>Tags</a><a href={url('glossary/')}>Glossary</a><a href={url('references/')}>References</a><a href={url('portfolio/')}>Portfolio</a><a href={url('rss.xml')}>RSS</a>
      </nav>
      <div style="display:flex;flex-wrap:wrap;gap:10px">
        {profiles.map((p) => <a class="tether" href={p.href} rel="me"><i></i>{p.name}</a>)}
      </div>
      <div style="display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px" class="ghost">
        <span class="label ghost">AlteranAI · built by Michal Malček and the hive</span>
        <span style="font-size:13px">Every figure on this site comes from a running system. Where one is unverified, it says so.</span>
      </div>
    </div>
  </footer>

  <nav class="bar" aria-label="Main (mobile)">
    {nodes.map((n) => <a class:list={{ on: node === n.slug }} href={url(`${n.slug}/`)}>{n.short}</a>)}
  </nav>

  <script>
    import '../scripts/myc.ts';
  </script>
  <script
    type="module"
    src="https://8491c799-c97a-4f42-827d-813f1731dde0.search.ai.cloudflare.com/assets/v0.0.25/search-snippet.es.js"
  ></script>

  <chat-bubble-snippet
    api-url="https://8491c799-c97a-4f42-827d-813f1731dde0.search.ai.cloudflare.com/"
    placeholder="Ask about Alteran AI..."
  ></chat-bubble-snippet>
</body>
</html>
